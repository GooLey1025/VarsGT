#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  ./varsgt --fq-dir-glob GLOB --index-dir DIR [options]

Required:
  --fq-dir-glob GLOB       Paired FASTQ glob, e.g. /data/reads/*.read{1,2}.fastq.gz
  --index-dir DIR          Giraffe graph index, e.g. /data/Nip_42_rice_Index

Common options:
  --panel-dir DIR          Genotyping panel. SNP/INDEL/SV sites, intervals, and
                           the Beagle reference panel are read from here.
                           Defaults to --index-dir.

  --project NAME           Project name (default: varsgt)
  --out-dir DIR            Output directory (default: ./varsgt_out)
  --work-dir DIR           Nextflow work directory (default: ./work)
  -w DIR                   Alias for --work-dir
  -resume [RUN]           Resume cached Nextflow tasks. RUN may be a run name,
                          session ID, or "last" (default when omitted)
  --resume                Backward-compatible alias for -resume
  --validate-only          Validate inputs and tools, then exit
  --help                   Show this help

Advanced options can be passed to Nextflow with --param value, for example:
  --giraffe-mapping-cpus-per-task 24
  --vg-path /absolute/path/to/vg   Use vg v1.71.0+ for format-v6 .hapl indexes
EOF
}

fq_dir_glob=""
index_dir=""
panel_dir=""
project="varsgt"
out_dir="./varsgt_out"
work_dir="./work"
resume_args=()
validate_only=false
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Compute nodes may not have external DNS/network access.
export NXF_OFFLINE="${NXF_OFFLINE:-true}"
args=(
    run "${script_dir}/main.nf"
)

while [[ $# -gt 0 ]]; do
    case "$1" in
        --fq-dir-glob)
            fq_dir_glob="$2"; shift 2 ;;
        --index-dir)
            index_dir="$2"; shift 2 ;;
        --panel-dir)
            panel_dir="$2"; shift 2 ;;
        --project)
            project="$2"; shift 2 ;;
        --out-dir)
            out_dir="$2"; shift 2 ;;
        --work-dir|-w|-work-dir)
            work_dir="$2"; shift 2 ;;
        -resume|--resume)
            resume_args=(-resume)
            if [[ $# -ge 2 && "$2" != -* ]]; then
                resume_args+=("$2")
                shift 2
            else
                shift
            fi ;;
        --validate-only)
            validate_only=true; shift ;;
        --help|-h)
            usage; exit 0 ;;
        --*)
            key="${1#--}"
            if [[ $# -lt 2 ]]; then
                echo "[ERROR] Missing value for ${1}" >&2
                exit 2
            fi
            args+=(--"${key//-/_}" "$2")
            shift 2 ;;
        *)
            echo "[ERROR] Unknown argument: $1" >&2
            usage >&2
            exit 2 ;;
    esac
done

[[ -n "$fq_dir_glob" ]] || { echo "[ERROR] --fq-dir-glob is required." >&2; exit 2; }
[[ -n "$index_dir" ]] || { echo "[ERROR] --index-dir is required." >&2; exit 2; }
args+=(
    --fq_dir_glob "$fq_dir_glob"
    --index_dir "$index_dir"
    --project "$project"
    --out_dir "$out_dir"
    -work-dir "$work_dir"
)
if [[ -n "$panel_dir" ]]; then
    args+=(--panel_dir "$panel_dir")
fi

$validate_only && args+=(--validate_only true) || true
if [[ ${#resume_args[@]} -gt 0 ]]; then
    args+=("${resume_args[@]}")
fi

exec nextflow "${args[@]}"
