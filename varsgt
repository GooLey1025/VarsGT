#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  ./varsgt --fq-dir-glob GLOB --index-dir DIR [options]

Required:
  --fq-dir-glob GLOB       Paired FASTQ glob, e.g. /data/reads/*.read{1,2}.fastq.gz
  --index-dir DIR          Panel root, e.g. /data/705rice_VarsGT_index

The six-column SV site file is discovered inside --index-dir.

Common options:
  --project NAME           Project name (default: varsgt)
  --out-dir DIR            Output directory (default: ./varsgt_out)
  --work-dir DIR           Nextflow work directory (default: ./work)
  --resume                 Resume cached Nextflow tasks
  --validate-only          Validate inputs and tools, then exit
  --help                   Show this help

Advanced options can be passed to Nextflow with --param value, for example:
  --giraffe-mapping-cpus-per-task 24
EOF
}

fq_dir_glob=""
index_dir=""
project="varsgt"
out_dir="./varsgt_out"
work_dir="./work"
resume=false
validate_only=false
nextflow_args=()
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --fq-dir-glob)
            fq_dir_glob="$2"; shift 2 ;;
        --index-dir)
            index_dir="$2"; shift 2 ;;
        --project)
            project="$2"; shift 2 ;;
        --out-dir)
            out_dir="$2"; shift 2 ;;
        --work-dir)
            work_dir="$2"; shift 2 ;;
        --resume)
            resume=true; shift ;;
        --validate-only)
            validate_only=true; shift ;;
        --help|-h)
            usage; exit 0 ;;
        --*)
            key="${1#--}"
            if [[ $# -lt 2 ]]; then
                echo "[ERROR] Missing value for ${1}" >&2
                exit 2
            fi
            nextflow_args+=(--"${key//-/_}" "$2")
            shift 2 ;;
        *)
            echo "[ERROR] Unknown argument: $1" >&2
            usage >&2
            exit 2 ;;
    esac
done

[[ -n "$fq_dir_glob" ]] || { echo "[ERROR] --fq-dir-glob is required." >&2; exit 2; }
[[ -n "$index_dir" ]] || { echo "[ERROR] --index-dir is required." >&2; exit 2; }
args=(
    run "${script_dir}/main.nf"
    --fq_dir_glob "$fq_dir_glob"
    --index_dir "$index_dir"
    --project "$project"
    --out_dir "$out_dir"
    -work-dir "$work_dir"
)

$validate_only && args+=(--validate_only true) || true
$resume && args+=(-resume) || true

exec nextflow "${args[@]}" "${nextflow_args[@]}"
